        <mxCell id="gate1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;dashed=1;fontSize=20;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;" value="&lt;b&gt;Quality gate 1:&lt;/b&gt; Retriever hợp lệ, không trùng; Loại bỏ retriever thừa bằng retriever policy; fallback retriever có confidence cao nhất" vertex="1">
