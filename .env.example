# --- OpenAI API trực tiếp (bắt buộc) ---
OPENAI_API_KEY=your-openai-api-key

# --- Model overrides (tùy chọn) ---
RESPONSE_LLM=gpt-4.1
ROUTER_LLM=gpt-4o
RETRIEVER_LLM=o3

# --- Vercel AI Gateway (comment — uncomment trong adapter/config.py để dùng lại) ---
# VERCEL_AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# RESPONSE_LLM=openai/gpt-4.1
# ROUTER_LLM=openai/gpt-4o
# RETRIEVER_LLM=openai/o3

# --- Google Gemini API (tạm comment — thường bị 503 high demand) ---
# GOOGLE_API_KEY=your-google-gemini-api-key
# GEMINI_API_KEY=your-google-gemini-api-key
# RESPONSE_LLM=gemini-3.5-flash
# ROUTER_LLM=gemini-3.1-flash-lite
# RETRIEVER_LLM=gemini-3.1-flash-lite
# CHAT_LLM=gemini-2.5-flash-lite
# ROUTER_FALLBACK_LLMS=gemini-2.5-flash-lite,gemini-3.5-flash
# RETRIEVER_FALLBACK_LLMS=gemini-2.5-flash-lite
# RESPONSE_FALLBACK_LLMS=gemini-3.1-flash-lite,gemini-2.5-flash
# RETRIEVER_THINKING_LEVEL=low
# RESPONSE_THINKING_LEVEL=low
# RETRIEVER_THINKING_BUDGET=4096
# RESPONSE_THINKING_BUDGET=2048

# --- Embedding / Neo4j vector search (retriever v2 params) ---
# Đang dùng Gemini embedding (semantic_embedding.py):
GOOGLE_API_KEY=your-google-gemini-api-key
# GEMINI_API_KEY=your-google-gemini-api-key
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- OpenAI embedding (tạm comment — uncomment + sửa semantic_embedding.py để dùng lại) ---
# Vercel Gateway thường không hỗ trợ /embeddings → dùng OpenAI trực tiếp:
# OPENAI_API_KEY=your-openai-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
NEO4J_VECTOR_INDEX=che_do_tai_san_semantic_embedding
# Params graph: cosine(query, node.embedding) — không dùng PARAM_MATCH_BACKEND nữa
EMBEDDING_MIN_SCORE=0.8
EMBEDDING_FALLBACK_TOP_K=2
EMBEDDING_VECTOR_CANDIDATE_K=64
# EMBEDDING_THRESHOLD=0.85
# Setup (một lần): python scripts/setup_neo4j_semantic_embeddings.py

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- PostgreSQL (Chainlit Data Layer) ---
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/chainlit_db

# --- Chainlit ---
CHAINLIT_AUTH_SECRET=change-me-to-a-long-random-string

# --- Conversation context / retrieval cache ---
# Pipeline build/import Neo4j phải tăng giá trị này khi dữ liệu pháp luật đổi.
KG_VERSION=2026-06-11.1
RECENT_FULL_TURNS=4
ROUTER_HISTORY_MAX_TOKENS=3000
RESPONSE_HISTORY_MAX_TOKENS=4000
OLDER_TURN_INDEX_LIMIT=20

# --- Graph visualize (V3 retriever) ---
VIZ_BASE_URL=http://localhost:8501
# VIZ_SNAPSHOT_DIR=data/viz_snapshots

# --- OAuth (Cần bật auth trong .chainlit/config.toml) ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
